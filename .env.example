# Copy this file to a new file named .env in the hw4/ folder (next to this file) and fill in the values.
# The real .env is ignored by git. Never commit real values; this example file holds placeholders only.

# Portkey key used for every model call (the Personal Assistant needs it; the rest of the site works without it).
PORTKEY_API_KEY=your-portkey-api-key-here

# Secret used to sign login session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random secret is created each time the backend starts,
# which logs everyone out on restart.
SESSION_SECRET=
